{
  "name": "waddletracker",
  "displayName": "WaddleTracker",
  "description": "Local-first developer activity tracking for Visual Studio Code.",
  "version": "0.0.1",
  "publisher": "ka0sdev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "waddletracker.showStatus",
        "title": "WaddleTracker: Show Status"
      },
      {
        "command": "waddletracker.openSettings",
        "title": "WaddleTracker: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "waddletracker.refreshStatistics",
        "title": "Refresh",
        "category": "WaddleTracker",
        "icon": "$(refresh)"
      },
      {
        "command": "waddletracker.excludeCurrentProject",
        "title": "WaddleTracker: Exclude Current Project"
      },
      {
        "command": "waddletracker.excludeCurrentFile",
        "title": "WaddleTracker: Exclude Current File"
      },
      {
        "command": "waddletracker.resetStatistics",
        "title": "WaddleTracker: Reset All Statistics"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "waddletracker",
          "title": "WaddleTracker",
          "icon": "resources/waddletracker.svg"
        }
      ]
    },
    "views": {
      "waddletracker": [
        {
          "type": "webview",
          "id": "waddletracker.currentActivity",
          "name": "Current Activity"
        },
        {
          "id": "waddletracker.sessionHistory",
          "name": "Session History"
        },
        {
          "type": "webview",
          "id": "waddletracker.dashboard",
          "name": "Statistics Dashboard"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "waddletracker.refreshStatistics",
          "when": "view == waddletracker.currentActivity",
          "group": "navigation@1"
        },
        {
          "command": "waddletracker.openSettings",
          "when": "view == waddletracker.currentActivity",
          "group": "navigation@2"
        },
        {
          "command": "waddletracker.refreshStatistics",
          "when": "view == waddletracker.sessionHistory",
          "group": "navigation@1"
        },
        {
          "command": "waddletracker.openSettings",
          "when": "view == waddletracker.sessionHistory",
          "group": "navigation@2"
        },
        {
          "command": "waddletracker.refreshStatistics",
          "when": "view == waddletracker.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "waddletracker.openSettings",
          "when": "view == waddletracker.dashboard",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "WaddleTracker",
      "properties": {
        "waddleTracker.idleTimeoutMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "Number of minutes without editor activity before WaddleTracker considers the current coding session idle.",
          "order": 10
        },
        "waddleTracker.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show WaddleTracker activity information in the VS Code status bar.",
          "order": 20
        },
        "waddleTracker.statusBar.display": {
          "type": "string",
          "enum": [
            "today",
            "project",
            "session"
          ],
          "enumDescriptions": [
            "Display total tracked coding time for today.",
            "Display the current project name alongside today's tracked time.",
            "Display active coding time for the current session."
          ],
          "default": "today",
          "markdownDescription": "Controls what WaddleTracker displays in the status bar.",
          "order": 30
        },
        "waddleTracker.tracking.excludedProjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Project names WaddleTracker should not track. Supports `*`, `**`, and `?` wildcard patterns, for example `private-*`.",
          "order": 40
        },
        "waddleTracker.tracking.excludedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "File names or workspace-relative paths WaddleTracker should not track. Supports glob-style `*`, `**`, and `?` wildcards, for example `**/.env*`, `secrets/**`, or `*.key`.",
          "order": 50
        },
        "waddleTracker.tracking.excludedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "VS Code language identifiers WaddleTracker should not track. Wildcards are supported, for example `plaintext` or `*react`.",
          "order": 60
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.0",
    "typescript": "^7.0.0"
  }
}
